# Copie para .env.local e ajuste
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/riftando"

# --- API oficial da Riot (perfil, revisão pós-jogo, estatística) -------------
# Chave gratuita em developer.riotgames.com. A de desenvolvimento expira em 24 h.
RIOT_API_KEY="RGAPI-50227cbe-9dd0-4bde-921b-657ba18dda6c"
# servidor padrão do coletor: br1, na1, euw1, kr…
RIOT_PLATFORM="br1"

# --- Cliente do LoL nesta máquina (sincronização da seleção e da partida) ----
# Só se o LoL não estiver em C:\Riot Games\League of Legends
# LEAGUE_PATH="D:\Jogos\Riot Games\League of Legends"

# Desenvolver sem o jogo aberto: dados gravados em scripts/fixtures
# RIFTANDO_LIVE_FIXTURE="scripts/fixtures/live-allgamedata.json"
# RIFTANDO_LCU_FIXTURE="scripts/fixtures/lcu-champselect.json"
